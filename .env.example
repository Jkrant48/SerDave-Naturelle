# Supabase Project Settings > Database > Session pooler URI; do not commit the real value.
SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Frontend build-time setting: use the base URL of the Render API web service,
# with no trailing slash or /api suffix.
VITE_API_URL=https://your-api-service.onrender.com

# The exact browser origin used by the frontend.
CLIENT_URL=http://localhost:5173

# Paystack secret key for server-side payment initialization and verification.
# Never use a VITE_ prefix or expose this key to browser code.
PAYSTACK_SECRET_KEY=sk_test_replace-with-your-paystack-secret-key

# Use a unique random secret of at least 32 characters for signing admin sessions.
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Use "none" only when the frontend and API are hosted on different sites over HTTPS.
ADMIN_COOKIE_SAME_SITE=lax
ADMIN_COOKIE_SECURE=false

# Supabase Project Settings > API. Keep the service-role key on the server only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=portfolio
